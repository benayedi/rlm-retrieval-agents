# CON-11 | OBLIQ congress (tip-of-tongue, 254 queries) | Document REPL agent | GPT-5.2 (high) | Gemini-Embedding-2, raw text
# model: gpt-5.2 via Azure deployment AZURE_DEPLOYMENT_GPT52 (original: a personal deployment); served_models: null
# effort requested: high; effort actually sent: high -- startup hook run5d (retry429 + azure_sampling + cap_ranking;
#   OBLIQ_CAP_RANKING=1 replaces the forced final-answer message with a request for a plain ranking)
# retriever: src/obliq_adapter.py on :8769 in front of the Gemini-Embedding-2 server (upstream URL / --index of the adapter: UNKNOWN)
# prompts: GEPA_PROMPTS=$RLM_DATA_DIR/obliq_fd_gemini/prompts_congress.json (record prompt_id 891e1319f80c); no grounding gate
# caps: --max-searches 10 (client-side), --max-iterations 30 (+1 forced final answer), FIXED k 20 (--fixed-k),
#   --max-timeout 3600, --lm-timeout 1800; run_experiment per-query guard 4200 s
# original output: <FULLDOC_ROOT>/runs/obliq_fd_congress (254 records; config read from one record; launch argv read from
#   _provenance.json: --workers 5, ids file below, installed rlm = RLMLIB_PATH)
ROW_ID=CON-11
BENCHMARK=obliq_congress
ENTRY=src/run_experiment.py
LAUNCHER="experiments/obliq_fd.sh fd congress <ids.json> <out_dir named obliq_fd_congress> 5"
WORKERS=5
OBLIQ_TASK=tip-of-tongue
OBLIQ_SUBSET=congress
IDS_FILE="${RLM_DATA_DIR}/obliq_congress/all254.json"
QUERIES_FILE="${RLM_DATA_DIR}/obliq_congress/queries.jsonl"
GEPA_PROMPTS="${RLM_DATA_DIR}/obliq_fd_gemini/prompts_congress.json"
OBLIQ_CAP_RANKING=1
ROOT_MODEL=gpt-5.2
SUB_MODEL=gpt-5.2
REASONING_EFFORT=high
SUB_REASONING_EFFORT=high
EFFORT_SENT=high
RETRIEVER="Gemini-Embedding-2 (obliq-tot-congress)"
SERVER=http://127.0.0.1:8769
MAX_SEARCHES=10
MAX_ITERATIONS=30
MAX_TIMEOUT=3600
RUN_ARGS='--name obliq_fd_congress --ids-file ${IDS_FILE} --workers 5 --stagger 0.3 --design B --server http://127.0.0.1:8769 --backend azure_openai --root-model gpt-5.2 --sub-model gpt-5.2 --root-deployment ${AZURE_DEPLOYMENT_GPT52} --sub-deployment ${AZURE_DEPLOYMENT_GPT52} --reasoning-effort high --sub-reasoning-effort high --default-k 20 --fixed-k --max-searches 10 --max-iterations 30 --seed-context --compaction --lean-prologue --no-delegation --solo-prompt --no-orchestrator --compaction-threshold-pct 0.85 --max-concurrent-subcalls 4 --max-timeout 3600 --lm-timeout 1800 --save-trajectory'
ENV_SET='AZURE_OPENAI_API_VERSION=2024-12-01-preview PYTHONPATH=<hooks>/run5d:<RLMLIB_PATH> OBLIQ_CAP_RANKING=1 RLM_USAGE_LOG=<out>/usage.jsonl OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 TOKENIZERS_PARALLELISM=false'
ENV_UNSET='SUP_FENCE_TOLERANT SUP_MAX_BLOCKS SUP_PRESENCE_PENALTY'
ORIGINAL_OUTPUT="<FULLDOC_ROOT>/runs/obliq_fd_congress"
