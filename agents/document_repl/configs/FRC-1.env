# FRC-1 | FRAMES (824) | Document REPL agent | Qwen3.6-35B-A3B (medium) | BM25 over Wikipedia 20230601.en on :8041
# The FR-13 configuration with search cap 25 and 50 turns (FR-13: 10 / 30); nothing else changed. Control: FR-13.
# model: qwen36-35b-a3b served by vLLM (:8030 for the 200 test questions; :8030 / :8031 for the other 624), --backend
#   openai; effort medium sent as reasoning_effort; presence_penalty 1.5; SUP_FENCE_TOLERANT=1, SUP_MAX_BLOCKS=5
# retriever: FRAMES BM25 search server on :8041 (benchmarks/retrieval/frames_search_server.py --protocol sup); BM25_PROMPT=1
#   -> src/run_bm25.py (record prompt_id 758e43ed5b95 = the BM25-patched prompt, as FR-13)
# caps: --max-searches 25 (client-side), --max-iterations 50 (+1 forced final answer), k model-chosen 1..50 with fallback
#   5, --max-timeout 5400, --lm-timeout 1800, xargs timeout 6300 (record config: hard_search_cap 25, max_iterations 50)
# runs: test200 2026-10-18 (sup_q36_bm25f_s25, 199 records, ids configs/frames_ids/test_ids_shuffled.txt, GPU 0, 8 workers);
#   the other 624 2026-10-19 (sup_q36_bm25f_s25_rest{0,1}: 311 + 312 records, configs/frames_ids/s25_rest_gpu{0,1}.txt,
#   8 workers each). 822 records; the 2 missing count wrong.
# judge: gpt-4.1 (graded_gpt41.json in each directory, 2026-11-10); superseded: Qwen3.6 (graded.json).
# original output: <original repo>/logs/frames/sup_q36_bm25f_s25{,_rest0,_rest1}
ROW_ID=FRC-1
BENCHMARK=frames
ENTRY=src/run_bm25.py
LAUNCHER="experiments/frames_qwen_cap25_test200.sh; experiments/frames_qwen_cap25_rest.sh"
CONTROL=FR-13
WORKERS=8
BM25_PROMPT=1
MODEL=qwen36-35b-a3b
ROOT_MODEL=qwen36-35b-a3b
SUB_MODEL=qwen36-35b-a3b
REASONING_EFFORT=medium
SUB_REASONING_EFFORT=medium
EFFORT_SENT=medium
RETRIEVER="BM25 over Wikipedia 20230601.en (FRAMES_DATA_DIR)"
SERVER=http://127.0.0.1:8041
MAX_SEARCHES=25
MAX_ITERATIONS=50
MAX_TIMEOUT=5400
SUP_FENCE_TOLERANT=1
SUP_MAX_BLOCKS=5
SUP_PRESENCE_PENALTY=1.5
IDS_FILES="configs/frames_ids/test_ids_shuffled.txt configs/frames_ids/s25_rest_gpu0.txt configs/frames_ids/s25_rest_gpu1.txt"
RUN_ARGS='--base-url ${BASE_URL} --design B --server http://127.0.0.1:8041 --backend openai --api-key-env ALIBABA_TOKEN --root-model qwen36-35b-a3b --sub-model qwen36-35b-a3b --reasoning-effort medium --sub-reasoning-effort medium --max-iterations 50 --max-searches 25 --seed-context --compaction --grounding-gate --lean-prologue --no-delegation --solo-prompt --no-orchestrator --compaction-threshold-pct 0.85 --max-concurrent-subcalls 4 --max-timeout 5400 --lm-timeout 1800 --save-trajectory'
ENV_SET='PYTHONPATH=<RLMLIB_PATH> ALIBABA_TOKEN=EMPTY QUERIES_FILE=<FRAMES_DATA_DIR>/frames_queries.jsonl OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 TOKENIZERS_PARALLELISM=false'
ORIGINAL_OUTPUT="<original repo>/logs/frames/sup_q36_bm25f_s25{,_rest0,_rest1}"
