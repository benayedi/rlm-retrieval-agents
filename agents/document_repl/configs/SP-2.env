# SP-2 | BrowseComp+ test200 (197 records) | Document REPL agent | Qwen3.6-35B-A3B (medium) | Reason-ModernColBERT 8192 (:8766)
#   behind the proxy with POLICY=rerank (Qwen3-Reranker-4B over the top 30, no novelty filter) -- the ablation of SP-1
# Control: BCP-29, its test200 records (gepa_bcp2/rollouts/ee5ea32a1c).
# model / effort / caps / split runner: as SP-1 (record config prompt_id 94f31e91f6b7, retrieval_server :8769)
# FINGERPRINT 7c62edcd, cache key 108e3760dc (reproduced by tests/test_follow_up_configs.py)
# run: 2026-10-10 18:17 -> 10-11 00:09, proxy :8769 on GPU 0 beside vLLM (RERANK_BATCH=6, RERANK_MEM_FRACTION=0.15;
#   ~20 s per search under 20 workers); that proxy version is NOT preserved (F-C), RERANK_XBATCH=0 is the closest path.
# judge: gpt-4.1 (logs/bcp_rejudge_gpt41/rq4_rerank_only.json, 2026-11-10); superseded: Qwen3.6 verdicts in cache.json.
# original output: <original repo>/logs/bcp_policy_e2e_rerankonly
ROW_ID=SP-2
BENCHMARK=browsecomp_plus
ENTRY=src/split_runner.py
LAUNCHER="studies/search_policy/experiments/sp2_bcp_qwen36_rerank_only.sh"
CONTROL="BCP-29 (test200)"
CACHE_KEY=108e3760dc
FINGERPRINT=7c62edcd
ROOT_MODEL=qwen36-35b-a3b
SUB_MODEL=qwen36-35b-a3b
REASONING_EFFORT=medium
SUB_REASONING_EFFORT=medium
EFFORT_SENT=medium
RETRIEVER="Reason-ModernColBERT PLAID 8192 (:8766) behind the rerank proxy, POLICY=rerank"
SERVER=http://127.0.0.1:8769
POLICY=rerank
DEPTH=30
RERANK_MODEL=Qwen/Qwen3-Reranker-4B
MAX_DOC_TOK=1024
PROXY_8769="RERANK_BATCH=6 RERANK_MEM_FRACTION=0.15"
MAX_SEARCHES=10
MAX_ITERATIONS=30
MAX_TIMEOUT=5400
GEPA_BCP_SERVERS=http://localhost:8030/v1
GEPA_BCP_MODEL=qwen36-35b-a3b
SUP_FENCE_TOLERANT=1
SUP_MAX_BLOCKS=5
SUP_PRESENCE_PENALTY=1.5
WORKERS=20
SPLIT_FILES="studies/prompt_optimisation/splits/bcp_gepa_splits/split.json (test200)"
RUN_ARGS='--design B --server http://127.0.0.1:8769 --backend openai --api-key-env ALIBABA_TOKEN --root-model qwen36-35b-a3b --sub-model qwen36-35b-a3b --reasoning-effort medium --sub-reasoning-effort medium --max-iterations 30 --max-searches 10 --seed-context --compaction --grounding-gate --lean-prologue --no-delegation --solo-prompt --no-orchestrator --compaction-threshold-pct 0.85 --max-concurrent-subcalls 4 --max-timeout 5400 --lm-timeout 1800 --save-trajectory'
ENV_UNSET='GEPA_PROMPTS'
ORIGINAL_OUTPUT="<original repo>/logs/bcp_policy_e2e_rerankonly"
