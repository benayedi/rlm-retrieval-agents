# SP-4 | FRAMES (824) | Document REPL agent | Qwen3.6-35B-A3B (medium) | BM25 over Wikipedia (:8041) behind the search-policy
#   proxy on :8042: novelty filter + Qwen3-Reranker-4B over BM25's top 30, scored against "<question> / Current search: <query>"
# The FRC-1 configuration (search cap 25, 50 turns) with SERVER = the proxy; nothing else changed. Control: FRC-1.
# model / effort / caps: as FRC-1 (record config: prompt_id 758e43ed5b95, hard_search_cap 25, max_iterations 50,
#   retrieval_server :8042)
# proxy: POLICY=novelty+rerank UPSTREAM=:8041 QUERIES_FILE=<FRAMES_DATA_DIR>/frames_queries.jsonl DEPTH 30 (default)
#   RERANK_MEM_FRACTION=0.20 RERANK_TOK_BUDGET=8000, GPU 1 (studies/search_policy/experiments/sp4_*.sh)
# runs: 2026-10-21/22, two directories by GPU: sup_q36_s25_rr_g0 (409 records, :8030) and _g1 (412, :8031), ids
#   configs/frames_ids/all824_shuf_gpu{0,1}.txt (412 + 412), 8 workers each; 821 records, the 3 missing count wrong.
#   Wall time not comparable with FRC-1 (the reranker shared GPU 1).
# judge: gpt-4.1 (graded_gpt41.json in each directory, 2026-11-10; 2 content-filtered prompts, 304 and 813, count wrong);
#   superseded: Qwen3.6 (graded.json).
# original output: <original repo>/logs/frames/sup_q36_s25_rr_g{0,1}
ROW_ID=SP-4
BENCHMARK=frames
ENTRY=src/run_bm25.py
LAUNCHER="studies/search_policy/experiments/sp4_frames_qwen36_cap25_rerank.sh (starts the proxy, then experiments/frames_qwen.sh twice)"
CONTROL=FRC-1
WORKERS=8
BM25_PROMPT=1
MODEL=qwen36-35b-a3b
ROOT_MODEL=qwen36-35b-a3b
SUB_MODEL=qwen36-35b-a3b
REASONING_EFFORT=medium
SUB_REASONING_EFFORT=medium
EFFORT_SENT=medium
RETRIEVER="BM25 over Wikipedia 20230601.en (:8041) behind the rerank proxy :8042"
SERVER=http://127.0.0.1:8042
POLICY=novelty+rerank
DEPTH=30
RERANK_MODEL=Qwen/Qwen3-Reranker-4B
RERANK_MEM_FRACTION=0.20
RERANK_TOK_BUDGET=8000
MAX_SEARCHES=25
MAX_ITERATIONS=50
MAX_TIMEOUT=5400
SUP_FENCE_TOLERANT=1
SUP_MAX_BLOCKS=5
SUP_PRESENCE_PENALTY=1.5
IDS_FILES="configs/frames_ids/all824_shuf_gpu0.txt configs/frames_ids/all824_shuf_gpu1.txt"
RUN_ARGS='--base-url ${BASE_URL} --design B --server http://127.0.0.1:8042 --backend openai --api-key-env ALIBABA_TOKEN --root-model qwen36-35b-a3b --sub-model qwen36-35b-a3b --reasoning-effort medium --sub-reasoning-effort medium --max-iterations 50 --max-searches 25 --seed-context --compaction --grounding-gate --lean-prologue --no-delegation --solo-prompt --no-orchestrator --compaction-threshold-pct 0.85 --max-concurrent-subcalls 4 --max-timeout 5400 --lm-timeout 1800 --save-trajectory'
ENV_SET='PYTHONPATH=<RLMLIB_PATH> ALIBABA_TOKEN=EMPTY QUERIES_FILE=<FRAMES_DATA_DIR>/frames_queries.jsonl'
ORIGINAL_OUTPUT="<original repo>/logs/frames/sup_q36_s25_rr_g{0,1}"
