# SP-7 | OBLIQ-Bench Twitter, descriptive (281 queries) | Document REPL agent | Qwen3.6-35B-A3B (medium) | Qwen3-Embedding-8B
#   dense search (:8010 via src/obliq_adapter.py :8767) behind the search-policy proxy on :8774: novelty filter +
#   Qwen3-Reranker-4B over the top 100, posts cut at 512 tokens, instruction "Given a request for social media posts that
#   implicitly express a described stance or pattern, judge whether this post matches the request"
# Control: TWQ-2 (the same agent and prompt on :8767, run at the same time).
# proxy: POLICY=novelty+rerank UPSTREAM=:8767 DEPTH=100 MAX_DOC_TOK=512 RERANK_TOK_BUDGET=8000 RERANK_MEM_FRACTION=0.13,
#   GPU 1, QUERIES_FILE=<FULLDOC_ROOT>/data/obliq_twitter/queries.jsonl (studies/search_policy/experiments/sp7_*.sh)
# status counts of the 281 records: completed 277, timeout 1, empty_output 2, error 1 (non-completed score NDCG 0).
# model: qwen36-35b-a3b on vLLM :8030 (--base-url), --backend openai; effort medium sent as reasoning_effort;
#   presence_penalty 1.5; SUP_FENCE_TOLERANT=1, SUP_MAX_BLOCKS=5
# prompts: GEPA_PROMPTS=configs/obliq/prompts_obliq.json (QUERY_TEMPLATE only; record prompt_id 00a9b02c72d6; original:
#   <FULLDOC_ROOT>/data/obliq_twitter/prompts_obliq.json); no grounding gate
# caps: FIXED k 30 (--default-k 30 --fixed-k), --max-searches 8 (client-side), --max-iterations 12, --max-timeout 3600,
#   --lm-timeout 1800 (record config: hard_search_cap 8, fixed_k 30, max_iterations 12, grounding_gate false)
# launch: 2026-10-12 20:55-20:58 UTC, both arms together (launch_argv in _provenance.json; command line in Claude Code
#   session 8ba31816); 10 workers each; ids configs/obliq_ids/ids281.json (original: <LOGS_ROOT>/obliq_rr/ids281.json).
# metric: NDCG@10 / gold recall against the OBLIQ qrels (no judge), scored by studies/search_policy/analysis/
#   compare_obliq_document_repl.py
# original output: <FULLDOC_ROOT>/runs/obliq_q36_rr
ROW_ID=SP-7
BENCHMARK=obliq_twitter
ENTRY=src/run_experiment.py
LAUNCHER="experiments/obliq_twitter_qwen36.sh ARM=rr (started by studies/search_policy/experiments/sp7_obliq_document_qwen36_rerank.sh, which starts the proxy)"
CONTROL=TWQ-2
WORKERS=10
OBLIQ_TASK=descriptive
OBLIQ_SUBSET=twitter
IDS_FILE="agents/document_repl/configs/obliq_ids/ids281.json"
QUERIES_FILE="${FULLDOC_ROOT}/data/obliq_twitter/queries.jsonl"
GEPA_PROMPTS="agents/document_repl/configs/obliq/prompts_obliq.json"
ROOT_MODEL=qwen36-35b-a3b
SUB_MODEL=qwen36-35b-a3b
REASONING_EFFORT=medium
SUB_REASONING_EFFORT=medium
EFFORT_SENT=medium
RETRIEVER="Qwen3-Embedding-8B exact flat (:8010) via :8767, behind the rerank proxy :8774"
SERVER=http://127.0.0.1:8774
POLICY=novelty+rerank
DEPTH=100
MAX_DOC_TOK=512
RERANK_MODEL=Qwen/Qwen3-Reranker-4B
RERANK_MEM_FRACTION=0.13
RERANK_TOK_BUDGET=8000
RERANK_INSTR="Given a request for social media posts that implicitly express a described stance or pattern, judge whether this post matches the request"
MAX_SEARCHES=8
MAX_ITERATIONS=12
MAX_TIMEOUT=3600
SUP_FENCE_TOLERANT=1
SUP_MAX_BLOCKS=5
SUP_PRESENCE_PENALTY=1.5
RUN_ARGS='--name obliq_q36_rr --ids-file ${IDS_FILE} --workers 10 --stagger 0.3 --design B --server http://127.0.0.1:8774 --backend openai --base-url http://localhost:8030/v1 --api-key-env ALIBABA_TOKEN --root-model qwen36-35b-a3b --sub-model qwen36-35b-a3b --reasoning-effort medium --sub-reasoning-effort medium --default-k 30 --fixed-k --max-searches 8 --max-iterations 12 --seed-context --compaction --lean-prologue --no-delegation --solo-prompt --no-orchestrator --compaction-threshold-pct 0.85 --max-concurrent-subcalls 4 --max-timeout 3600 --lm-timeout 1800 --save-trajectory'
ENV_SET='PYTHONPATH=<RLMLIB_PATH> ALIBABA_TOKEN=EMPTY QUERIES_FILE=<FULLDOC_ROOT>/data/obliq_twitter/queries.jsonl GEPA_PROMPTS=configs/obliq/prompts_obliq.json SUP_FENCE_TOLERANT=1 SUP_MAX_BLOCKS=5 SUP_PRESENCE_PENALTY=1.5'
ORIGINAL_OUTPUT="<FULLDOC_ROOT>/runs/obliq_q36_rr"
