# DSPy.RLM: every environment variable read by src/ (and by the shared modules it imports), with the code's default
# and a one-line meaning. Machine-specific locations (PYTHON, HF_HOME, OBLIQ_BENCH_ROOT) are in <repo>/configs/paths.env,
# which the launchers in ../experiments source.
#
# Only the REQUIRED lines are active. Every optional variable is COMMENTED OUT and shows its default: the code treats
# "set to an empty string" differently from "unset" (int("") raises, an empty model name is sent as is), so uncomment a
# line only to set a real value.
# Usage:  cp example.env my.env; fill in; set -a; . my.env; set +a
# No per-experiment configs: DSPy.RLM has no row in the final results table (docs/Experiments.xlsx).

# ── Retrieval server ─────────────────────────────────────────────────────────────────────────────────────
EMBEDDING_SERVER_URL=                       # REQUIRED. Search server base URL (POST /search, /document; GET /health); launchers suggest http://localhost:8010
#RETRIEVER_TIMEOUT=60                       # HTTP timeout (s) of each /search and /document request
#OBLIQ_INDEX=                               # default unset = server's default index. Index name sent with every request to a multi-index server
#OBLIQ_BENCH_ROOT=                          # REQUIRED for run_obliq.py; set in <repo>/configs/paths.env. OBLIQ-Bench data root

# ── Azure OpenAI: root LM (default), sub-LM, BrowseComp judge ──────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=                      # REQUIRED, also in local-LLM runs (BrowseComp sub-LM and judge are always Azure). https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=                       # REQUIRED. Azure OpenAI key; never commit
#AZURE_OPENAI_API_VERSION=2024-12-01-preview  # API version of root LM, sub-LM and judge
#AZURE_OPENAI_MODEL=gpt-5.4-mini            # Root-LM deployment; last fallback of sub-LM and judge. run_obliq.py --model overrides it
#AZURE_OPENAI_MAX_TOKENS=16000              # Root-LM max output tokens
#AZURE_OPENAI_TIMEOUT=120                   # Root-LM request timeout (s)
#AZURE_OPENAI_REASONING_EFFORT=             # default unset = model default. Root-LM reasoning_effort; BrowseComp sub-LM fallback
#AZURE_OPENAI_JUDGE_MODEL=                  # default unset. BrowseComp: sub-LM fallback after SUB_LM_MODEL, and the judge. OBLIQ: sub-LM deployment

# ── Local OpenAI-compatible root LM (setting LOCAL_LLM_BASE_URL switches build_lm away from Azure) ──────────
#LOCAL_LLM_BASE_URL=                        # default unset = Azure. e.g. http://localhost:8030/v1 (vLLM); obliq_shard.sh sets that by default
#LOCAL_LLM_MODEL=qwen3.8-27b-bf16           # Served model name, sent as openai/<name>
#LOCAL_LLM_API_KEY=EMPTY                    # API key for the local server
#LOCAL_LLM_MAX_TOKENS=16000                 # Local root-LM max output tokens
#LOCAL_LLM_EFFORT=medium                    # Local root-LM reasoning_effort
#LOCAL_LM_TIMEOUT=1800                      # Local root-LM request timeout (s)
#LOCAL_LLM_PRESENCE_PENALTY=                # default unset = not sent. presence_penalty of the local root LM
#LOCAL_SUB_LM=                              # default unset. OBLIQ only: 1 (with LOCAL_LLM_BASE_URL) runs llm_query on the local model

# ── Sub-LM behind llm_query ─────────────────────────────────────────────────────────────────────────────
#SUB_LM_MODEL=                              # default AZURE_OPENAI_JUDGE_MODEL, else AZURE_OPENAI_MODEL, else gpt-5.4-mini. BrowseComp sub-LM deployment
#SUB_LM_MAX_TOKENS=8000                     # BrowseComp sub-LM max output tokens
#SUB_LM_TIMEOUT=120                         # BrowseComp sub-LM timeout (s)
#SUB_LM_REASONING_EFFORT=                   # default unset. BrowseComp: sub-LM effort (else AZURE_OPENAI_REASONING_EFFORT). OBLIQ: sent if set, and the sub-LM cap becomes 16000 tok / 300 s (else 4000 / 60)

# ── BrowseComp+ agent tools and budgets (dspy_rlm/agent.py, dspy_rlm/signatures.py) ─────────────────────────
#MAX_TOP_K=                                 # default unset = no clamp. Hard ceiling on search_index top_k
#MAX_SEARCH_PER_TURN=                       # default unset = off. Max searches per REPL code block (a turn = searches < 5 s apart)
#SEARCH_SNIPPET_TOKENS=                     # default unset. Cut snippets to N Qwen/Qwen3-0.6B tokens (loads the tokenizer); replaces SEARCH_SNIPPET_LEN
#SEARCH_SNIPPET_LEN=500                     # Cut snippets to N characters (+ "…"); BrowseComp and OBLIQ
#GETDOC_INLINE_CHARS=6000                   # get_document prints documents up to N chars into the context and words its docstring accordingly (0 = never)
#MINIMAL_TOOL_DOCS=                         # default unset. Non-empty and not 0/false: one-line BrowseComp+-harness tool docstrings
#DISABLE_GET_DOCUMENT=                      # default unset. Non-empty and not 0/false: search-only ablation (no get_document tool)
#RLM_MAX_OUTPUT_CHARS=                      # default unset = dspy's 10,000. Per-REPL-block stdout cap, dspy.RLM(max_output_chars=)
#BROWSECOMP_COMMIT_TURN=                    # default unset = round(0.75 * max_iters). Commit-deadline turn of the v3 signature, clamped to [2, max_iters]
#BROWSECOMP_TIMEOUT=0                       # Default of run_browsecomp.py --timeout: per-question limit (s), 0 = none; run in a subprocess

# ── OBLIQ driver (run_obliq.py) ───────────────────────────────────────────────────────────────────────────
#OBLIQ_TIMEOUT=0                            # Default of --timeout: per-question limit (s), 0 = none; run in a daemon thread
#OBLIQ_LOG_TRAJECTORY=1                     # 0 omits the REPL transcript from the per-question records
#OBLIQ_RELATIVE_SCORES=                     # default unset. 1 replaces the fixed score cutoffs in the prompt (rlm_shared.obliq_score_advice)
#DSPY_FORMAT_FIX=                           # default unset. 1 patches dspy.RLM at import: reasoning/code cue + 3 parse attempts per turn

# ── Launchers only (../experiments/obliq_shard.sh, ../experiments/browsecomp.sh) ──────────────────────────────
#OBLIQ_TASK=descriptive                     # --task of every shard
#OBLIQ_SUBSET=twitter                       # --subset of every shard
#                                           # (obliq_shard.sh also defaults OBLIQ_INDEX to obliq-des-twitter)
#DENO_INSTALL=$HOME/.deno                   # Deno install dir; $DENO_INSTALL/bin goes on PATH (dspy.RLM's REPL runs in Deno)
