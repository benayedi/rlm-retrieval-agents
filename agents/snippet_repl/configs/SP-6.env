# SP-6  snippet REPL agent | Qwen3.6-35B-A3B (vLLM :8030 / :8031, effort medium) | Qwen3-Embedding-8B dense (:8010) behind the
#       search-policy proxy on :8775 (WIRE=mine): novelty filter + Qwen3-Reranker-4B over the top 100, posts cut at 512
#       tokens, instruction "Given a request for social media posts that implicitly express a described stance or pattern,
#       judge whether this post matches the request" | OBLIQ Twitter, descriptive (281 q). Control: TWQ-1.
# Budgets and agent switches: identical to TWQ-1 (12 turns, top_k 20, no search cap, Qwen3.6 switches, search tagging).
# Proxy (studies/search_policy/experiments/sp6_obliq_snippet_qwen36_rerank.sh; RECONSTRUCTED from session transcripts):
#   dev100   POLICY=novelty+rerank WIRE=mine UPSTREAM=:8010 DEPTH=100 MAX_DOC_TOK=512 RERANK_TOK_BUDGET=8000
#            RERANK_MEM_FRACTION=0.15, GPU 1 (2026-10-13; rr_dev100: 10 shards, 100 records)
#   rest181  the same with RERANK_MEM_FRACTION=0.20 (2026-10-21; rr_rest181_g{0,1}: 8 shards each, 91 + 90 records)
#   QUERIES_FILE=<FULLDOC_ROOT>/data/obliq_twitter/queries.jsonl (the question text the reranker scores against)
# Metric: NDCG@10 / gold recall against the OBLIQ qrels (no judge); all 281: studies/search_policy/analysis/
#   compare_obliq_snippet_281.py (dev100 alone: compare_obliq_snippet_dev100.py).
# Original outputs: <original repo>/logs/obliq_mine_rr/{rr_dev100*,rr_rest181_g*}
# Use: SLICE=dev100 experiments/run_config.sh configs/SP-6.env; then SLICE=rest181
ROW=SP-6
LAUNCHER=../../studies/search_policy/experiments/sp6_obliq_snippet_qwen36_rerank.sh
LAUNCHER_ARGS=("${SLICE:?set SLICE=dev100 or SLICE=rest181 (SP-6 is both)}")
# --- effective environment of every shard process (set by the launchers; listed for the record) ---
export ARM=rr
export EMBEDDING_SERVER_URL=http://localhost:8775 OBLIQ_INDEX=obliq-des-twitter OBLIQ_TASK=descriptive OBLIQ_SUBSET=twitter
export LOCAL_LLM_MODEL=qwen36-35b-a3b LOCAL_LM_TIMEOUT=1800 OBLIQ_REPL_CUE=1 OBLIQ_FENCE_TOLERANT=1 OBLIQ_PRESENCE_PENALTY=1.5
export OBLIQ_TAG_SEARCH=1 ORCHESTRATOR=0 LIGHTON_TOOL_DOCS=1 LIGHTON_TASK_TEXT=1 SEARCH_SNIPPET_TOKENS=512 OFFICIAL_TOP_K=20
export AZURE_OPENAI_REASONING_EFFORT=medium SUB_LM_REASONING_EFFORT=medium
# proxy settings (read by rerank_proxy.py, set by the SP-6 launcher; listed for the record):
#   POLICY=novelty+rerank WIRE=mine UPSTREAM=http://127.0.0.1:8010 DEPTH=100 MAX_DOC_TOK=512 RERANK_TOK_BUDGET=8000
#   RERANK_MEM_FRACTION=0.15 (dev100) / 0.20 (rest181) RERANK_MODEL=Qwen/Qwen3-Reranker-4B (default)
