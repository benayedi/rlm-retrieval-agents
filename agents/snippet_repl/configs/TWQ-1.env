# TWQ-1  snippet REPL agent | Qwen3.6-35B-A3B (vLLM :8030 / :8031, effort medium) | Qwen3-Embedding-8B dense (exact flat index
#        obliq-des-twitter) on :8010 | OBLIQ Twitter, descriptive (281 q) -- the control of SP-6; not a results-table row
# Budgets: 12 turns, depth 1, no compaction, NO search cap, top_k default 20 (OFFICIAL_TOP_K), 512-token snippets, per-LM-call
#          timeout 1800 s (LOCAL_LM_TIMEOUT); Qwen3.6 switches OBLIQ_REPL_CUE=1 OBLIQ_FENCE_TOLERANT=1 OBLIQ_PRESENCE_PENALTY=1.5;
#          OBLIQ_TAG_SEARCH=1. Format gate ON (OBLIQ_NO_FORMAT_GATE not set).
# Two slices, run at different times (studies/search_policy/CHANGES_FROM_ORIGINAL.md SP-I15):
#   dev100   2026-10-13 (ctrl_dev100: 10 shards, 100 records; LLM :8030); RECONSTRUCTED launch (session transcript 8ba31816)
#   rest181  2026-10-20/21 (snip_rest181_g{0,1}: 8 shards each, 91 + 90 records; LLM :8030 / :8031), the SNIP branch of
#            original/RLM_2026-11-11/RLM/scripts/obliq_best_chain.sh after src/obliq_pick_best.py chose the snippet REPL
#            agent on dev100 (all 281: NDCG@10 0.0759, obliq_best_chain.log)
# Metric: NDCG@10 / gold recall against the OBLIQ qrels (no judge).
# In-run "correct" field: none used (OBLIQ). Original outputs: <original repo>/logs/obliq_mine_rr/{ctrl_dev100*,snip_rest181_g*}
# Question ids: studies/prompt_optimisation/splits/obliq_splits/twitter_dev.json (dev100); configs/obliq/twitter/obliq_fd/
#   rest181_g{0,1}.json (rest181; byte-identical copies of <original repo>/data/obliq_fd/)
# Use: SLICE=dev100 experiments/run_config.sh configs/TWQ-1.env; then SLICE=rest181 (both slices make the 281)
ROW=TWQ-1
LAUNCHER=experiments/obliq_twitter_qwen36.sh
LAUNCHER_ARGS=()
export ARM=ctrl
export SLICE=${SLICE:?set SLICE=dev100 or SLICE=rest181 (TWQ-1 is both)}
# --- effective environment of every shard process (set by the launchers; listed for the record) ---
export EMBEDDING_SERVER_URL=http://localhost:8010 OBLIQ_INDEX=obliq-des-twitter OBLIQ_TASK=descriptive OBLIQ_SUBSET=twitter
export LOCAL_LLM_MODEL=qwen36-35b-a3b LOCAL_LM_TIMEOUT=1800 OBLIQ_REPL_CUE=1 OBLIQ_FENCE_TOLERANT=1 OBLIQ_PRESENCE_PENALTY=1.5
export OBLIQ_TAG_SEARCH=1 ORCHESTRATOR=0 LIGHTON_TOOL_DOCS=1 LIGHTON_TASK_TEXT=1 SEARCH_SNIPPET_TOKENS=512 OFFICIAL_TOP_K=20
export AZURE_OPENAI_REASONING_EFFORT=medium SUB_LM_REASONING_EFFORT=medium   # obliq_shard.sh defaults (ROOT_EFFORT / SUB_EFFORT unset)
# dev100: LOCAL_LLM_BASE_URL=http://localhost:8030/v1 (obliq_shard.sh default), RLM_TRAJ_DIR=obliq_mine_rr/traj_ctrl, 10 workers
# rest181: LOCAL_LLM_BASE_URL=http://localhost:803{0,1}/v1 per half, RLM_TRAJ_DIR=obliq_mine_rr/traj_snip_rest181, 8 workers,
#   OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 TOKENIZERS_PARALLELISM=false
#   CLI per shard: run_obliq.py --ids-file <shard>.json --max-iterations 12 --max-depth 1 --out <out>_s<k>
