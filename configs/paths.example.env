# Machine-specific settings. Copy to configs/paths.env (git-ignored), fill in, then:  set -a; . configs/paths.env; set +a
# The values in comments are the ones used for the original runs (one GPU server, October 2026).

# github.com/alexzhang13/rlm checked out at commit 854e688 (v0.1.3). Put on PYTHONPATH by the launchers.
RLMLIB_PATH=                 # original: /home/extstu_00/rlmrepo
# Document REPL agent data directory: data/prepared/{corpus,queries}.jsonl, data/indexes/{bm25s,lighton,qwen3-embedding-8b}, data/models/Qwen3-0.6B
FULLDOC_ROOT=                # original: /home/extstu_00/suprlm
# OBLIQ-Bench task data
OBLIQ_BENCH_ROOT=            # original: /home/extstu_00/OBLIQ-Bench
# FRAMES question files and Wikipedia BM25 index
FRAMES_DATA_DIR=             # original: /home/extstu_00/RLM/data/frames
# BrowseComp-Plus BM25 index (k1 0.9, b 0.4)
BCP_BM25_INDEX_DIR=          # original: /home/extstu_00/RLM/data/bcp_bm25_default
# Run outputs
RUNS_DIR=./runs

# Azure OpenAI. AZ_ENV is a file with two lines: AZ_EP=https://<resource>.openai.azure.com  AZ_KEY=<key>
AZ_ENV=
AZURE_DEPLOYMENT_GPT5=       # serves gpt-5 (2025-08-07)
AZURE_DEPLOYMENT_GPT52=      # serves gpt-5.2
AZURE_DEPLOYMENT_JUDGE=gpt-4.1

# Google Vertex AI (Gemini-Embedding-2 index build and search server, benchmarks/retrieval/gemini/).
# A .env-format file with NNEXT_PROVIDERS_GCP_VERTEX_SERVICE_ACCOUNT_JSON=<service-account JSON>; only read when that
# variable is not already exported. Never committed, never printed.
GCP_VERTEX_ENV=              # original: the .env of the original repository

# Reporting (scripts/reporting/, agents/shared/rlm_shared/grading/rejudge_bcp.py): inputs that exist only on the original machine
LOGS_ROOT=                   # root of the original run logs (logs/ of the original repository); original: /home/extstu_00/RLM/logs
ORIGINAL_REPO_ROOT=          # original research repository (docs/, scripts/workbook/tokmaps/); original: /home/extstu_00/RLM
# Checkout holding scripts/retrieval_eval.py (not in this repository), for benchmarks/retrieval/build_bc_rmcb_dl8192.sh
RETRIEVAL_EVAL_ROOT=         # original: /home/extstu_00/master

# Interpreters (the original runs used three environments)
PYTHON=python                # env with rlm deps, dspy 3.3.1, vllm client, bm25s, faiss
PYLATE_PYTHON=python         # env with pylate (Reason-ModernColBERT server)
GEMINI_PYTHON=python         # env with google-cloud-aiplatform (Gemini-Embedding-2 server)
HF_HOME=~/.cache/huggingface

# ---- Needed only by specific launchers (each one stops with a message naming the variable when it is missing)
RLM_DATA_DIR=                # data/ of the original repository: OBLIQ question-id files, OBLIQ document REPL prompt files, BCP split files
                             #   (agents/document_repl/experiments/obliq_fd.sh, src/split_runner.py)
HOOKS_DIR=                   # startup hooks; default agents/snippet_repl/src/hooks (set by the document REPL _common.sh)
AZURE2_API_VERSION=          # document REPL run_one.py / judge.py: Azure API version when AZURE2_* credentials are used (e.g. 2024-12-01-preview)
NOORCH_QIDS_FILE=            # september/bcp_snip_no_orchestrator.sh (BCP-11): file with the question indices of that block (not preserved)
GRADERS_DIR=                 # snippet experiments/ops/*: directory holding the graders (use agents/shared/rlm_shared/grading)
FD_DENSE_PATTERN=            # snippet experiments/ops/night_finisher.sh: regex matching the document REPL dense run's command line
FRAMES_GRADE_SUP=            # full_doc experiments/frames_qwen.sh: the original repository's frames_grade_sup.py (interim Qwen judge, not part of this repository)
BCP_POLICY_COMPARE=          # full_doc src/bcp_bm25_split.py: the original repository's bcp_policy_compare.py (not part of this repository)
